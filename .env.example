# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string

# ── Provisioning encryption (Fernet) ─────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(40))"
# IMPORTANT: rotating this key invalidates all existing Grant secrets.
# Store separately from DJANGO_SECRET_KEY so they can be rotated independently.
PROVISIONING_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://berlanggan:berlanggan@localhost:5432/berlanggan

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ── Duitku (payment gateway) ─────────────────────────────────────────────────
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_CALLBACK_URL=https://yourdomain.com/billing/webhook/duitku/
DUITKU_SANDBOX=True

# ── Google OAuth (django-allauth) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
WA_BACKEND=console
WA_TOKEN=

# ── Email ─────────────────────────────────────────────────────────────────────
# Switch to the SMTP backend to send real email (console backend just prints to stdout).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@berlanggan.com
