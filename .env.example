# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string

# ── Provisioning encryption (Fernet) ─────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(40))"
# IMPORTANT: rotating this key invalidates all existing Grant secrets.
# Store separately from DJANGO_SECRET_KEY so they can be rotated independently.
PROVISIONING_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://berlanggan:berlanggan@localhost:5432/berlanggan

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ── Sumopod (payment gateway) ────────────────────────────────────────────────
# API key from Sumopod dashboard → Settings > API Key.
SUMOPOD_API_KEY=
# Svix signing secret (whsec_...) and shared token (whtok_...) from
# Settings > Webhook. Register the webhook URL there:
#   https://yourdomain.com/billing/webhook/sumopod/
SUMOPOD_WEBHOOK_SECRET=
SUMOPOD_WEBHOOK_TOKEN=
SUMOPOD_SANDBOX=True

# ── Entitlement signing (Ed25519) ────────────────────────────────────────────
# Signs the `entitlement` envelope in /v1/activate and /v1/validate responses so
# a licensed product can verify it wasn't tampered with. Env-only, never Setting/DB
# (same rationale as SUMOPOD_API_KEY). Generate a pair with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; import base64; k=Ed25519PrivateKey.generate(); print('private (keep secret):', base64.b64encode(k.private_bytes_raw()).decode()); print('public (ship to product):', base64.b64encode(k.public_key().public_bytes_raw()).decode())"
# Ship the printed public key to the product's licensing/marketplace_key.py.
# Leaving this unset degrades to unsigned responses (dev convenience only).
MARKETPLACE_ED25519_PRIVATE_KEY_B64=

# ── Google OAuth (django-allauth) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
WA_BACKEND=console
WA_TOKEN=

# ── Email ─────────────────────────────────────────────────────────────────────
# Switch to the SMTP backend to send real email (console backend just prints to stdout).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
# Port 587 → EMAIL_USE_TLS=True (STARTTLS). Port 465 → EMAIL_USE_SSL=True instead.
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@berlanggan.com
